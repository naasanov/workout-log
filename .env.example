# Local development environment variables (used when JAWSDB_URL is not set)
# Copy this file to .env and fill in values for local dev with docker-compose.
# Do NOT commit .env — it is in .gitignore.

DB_HOST=127.0.0.1
DB_USERNAME=dev
DB_PASSWORD=dev
DB_NAME=workout_log

# Nutrition feature API keys
USDA_FDC_API_KEY=
OPENAI_API_KEY=

# AI usage tracking
# Set OWNER_EMAIL to your email to unlock the all-users cost breakdown at GET /api/nutrition/usage
OWNER_EMAIL=
# Agent model (OpenAI model id). Defaults to gpt-5.6-terra when unset or blank.
AGENT_MODEL=
# Optional per-1M-token overrides (USD) for the agent's model, independent of
# each other. Unset ones fall back to that model's entry in services/nutrition/usage.ts.
AGENT_INPUT_PER_1M=
AGENT_CACHED_INPUT_PER_1M=
AGENT_OUTPUT_PER_1M=

# OpenAI Organization Costs API (optional) — supplements estimated cost with actual billed cost.
# Admin API key (not a regular project key); unset disables the actual-cost overlay entirely.
OPENAI_ADMIN_KEY=
# Comma-separated project id(s) to scope the actual-cost query to; unset queries the whole org.
OPENAI_PROJECT_ID=

# Feedback feature — GitHub integration (optional)
# When GITHUB_TOKEN is set, feedback submissions also create GitHub issues.
# Personal access token with repo:write scope (or a fine-grained token with Issues: write).
GITHUB_TOKEN=
# Repository to file issues against (owner/repo). Defaults to naasanov/workout-log.
GITHUB_REPO=naasanov/workout-log
# Public base URL this app is reachable at, used to link feedback screenshots
# in the GitHub issue body (e.g. https://peak-pr-tracker.herokuapp.com). Falls
# back to deriving it from the request when unset.
PUBLIC_APP_URL=

# Frontend env vars (Vite) — place these in client/.env.local for local dev
# In production (Heroku), set them via: heroku config:set VITE_API_URL=... --app peak-pr-tracker
VITE_API_URL=
